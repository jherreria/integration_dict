# --- Local development -------------------------------------------------
# Run with identity faked from env instead of Databricks Apps headers.
DEV_MODE=true
DEV_USER_EMAIL=dev.user@example.com
DEV_USER_NAME=Dev User
# "integration" (admin) or "general"
DEV_USER_ROLE=integration

# --- Database ------------------------------------------------------------
# Default is a local SQLite file. Any SQLAlchemy URL works (e.g. Postgres).
DATABASE_URL=sqlite:///./integration_dict.db
# To use Databricks Lakebase instead, set the instance name (DATABASE_URL is
# then ignored). Requires databricks-sdk auth (automatic inside a Databricks App).
# LAKEBASE_INSTANCE_NAME=integration-dict-db
# LAKEBASE_DATABASE=databricks_postgres
# Inside a Databricks App the Postgres user is injected (PGUSER). Connecting to
# Lakebase from your laptop with a PAT/CLI profile has no client id, so set your
# Databricks identity (email) explicitly:
# LAKEBASE_USER=you@example.com

# --- Access control --------------------------------------------------------
# Comma-separated Entra/Databricks group names whose members get the
# "integration" (admin) role. Everyone else authenticated is "general".
ADMIN_GROUPS=integration-admins

# --- AI search -------------------------------------------------------------
# Databricks model serving endpoint used for semantic search embeddings.
# Leave unset to use keyword search only.
# EMBEDDING_ENDPOINT=databricks-gte-large-en

# --- Databricks workspace (injected automatically inside a Databricks App) --
# DATABRICKS_HOST=https://adb-1234567890123456.7.azuredatabricks.net
# DATABRICKS_CLIENT_ID=...
# DATABRICKS_CLIENT_SECRET=...
